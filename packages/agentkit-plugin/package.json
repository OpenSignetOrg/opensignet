{
  "name": "@opensignet/agentkit-plugin",
  "version": "0.1.0",
  "description": "Coinbase AgentKit action provider for OpenSignet agent-native identity and communications workflows",
  "keywords": [
    "opensignet",
    "ai-agents",
    "coinbase-agentkit",
    "identity",
    "x402",
    "base"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSignetOrg/opensignet.git",
    "directory": "packages/agentkit-plugin"
  },
  "homepage": "https://docs.opensignet.com/frameworks/agentkit",
  "bugs": {
    "url": "https://github.com/OpenSignetOrg/opensignet/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm --filter @opensignet/sdk build && pnpm run build && node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@opensignet/sdk": "workspace:^",
    "@opensignet/shared": "workspace:^",
    "viem": "^2.56.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@coinbase/agentkit": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
