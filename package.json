{
  "name": "opensignet-public",
  "version": "0.1.0",
  "private": true,
  "description": "Public OpenSignet SDKs, integrations, documentation and contract records.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "verify": "node scripts/verify.ts",
    "sync:brand": "node scripts/sync-brand.ts",
    "build": "turbo run build --filter=!@opensignet/contracts",
    "typecheck": "turbo run typecheck --filter=!@opensignet/contracts && tsc -p scripts && tsc -p contracts",
    "lint": "turbo run lint --filter=!@opensignet/contracts",
    "test": "node --test \"scripts/*.test.ts\" \"scripts/seo/test/*.test.ts\" && turbo run test --filter=!@opensignet/contracts && pnpm --filter @opensignet/contracts test",
    "check:public-boundary": "node scripts/check-public-boundary.ts",
    "check:production-licenses": "node scripts/check-production-licenses.ts",
    "audit:production:high": "pnpm audit --prod --audit-level high",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,md,mdx,json,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,mts,md,mdx,json,yml,yaml}\"",
    "release:version": "node scripts/release.ts version",
    "release:prepare": "node scripts/release.ts pack",
    "release:check-registry": "node scripts/release.ts check-registry",
    "release:verify-pack": "node scripts/release.ts verify-pack"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.9.5",
    "turbo": "^2.10.12",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "browserslist@<4.28.7": "4.28.7",
      "@hono/node-server@<2.1.6": "2.1.6",
      "axios@>=1.15.2 <1.18.0": "1.18.0",
      "@reown/appkit-wallet>zod": "4.6.7",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "decode-uri-component@<0.5.1": "0.5.1",
      "devalue@>=5.0.0 <5.9.3": "5.9.3",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "hono@<4.13.16": "4.13.16",
      "http-cache-semantics": "4.3.0",
      "ip-address@<=10.7.3": "10.7.4",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "proxy-addr@>=2.0.0 <2.0.8": "2.0.8",
      "qs@<6.16.2": "6.16.2",
      "sharp@<0.35.5": "0.35.5",
      "smol-toml@<1.9.0": "1.9.0",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "undici@>=6.0.0 <6.29.1": "6.29.1",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "undici@>=8.0.0 <8.12.2": "8.12.2",
      "use-sync-external-store@<1.4.0": "1.4.0",
      "uuid@<11.1.1": "11.1.1",
      "vite@>=8.2.0 <=8.3.5": "8.3.5",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch",
      "http-cache-semantics@4.3.0": "patches/http-cache-semantics@4.3.0.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "workerd"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5",
        "GHSA-fc5q-39xc-vjpf"
      ]
    }
  }
}
